OPENAI_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=Qwen/Qwen3-8B
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_HEALTHCHECK_PATH=/models
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=54903
KINGBASE_HOST=127.0.0.1
KINGBASE_PORT=54321
KINGBASE_DATABASE=emdmp
KINGBASE_USER=system
KINGBASE_PASSWORD=your_password_here
KINGBASE_CONNECT_TIMEOUT_SECONDS=5
# Optional: absolute path to a custom model entry; empty uses the bundled model.
SALES_FORECAST_MODEL_FILE=
