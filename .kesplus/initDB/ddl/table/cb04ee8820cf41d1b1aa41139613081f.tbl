{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-20 14:19:01","sql":"CREATE TABLE \"${schemaName}\".\"b_merchant_diagnostics\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"merchant_id\" bigint   NOT NULL ,\n\"merchant_buyer_count\" int   NOT NULL ,\n\"merchant_positive_rate\" decimal   NOT NULL ,\n\"avg_repurchase_score\" decimal   NOT NULL ,\n\"high_priority_user_count\" int   NOT NULL ,\n\"risk_user_count\" int   NOT NULL ,\n\"merchant_tag\" varchar   NOT NULL ,\nCONSTRAINT \"b_merchant_diagnostics_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"b_merchant_diagnostics\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"merchant_id\" IS '商家ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"merchant_buyer_count\" IS '商家买家数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"merchant_positive_rate\" IS '商家好评率字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"avg_repurchase_score\" IS '平均复购分数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"high_priority_user_count\" IS '高优先级用户数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"risk_user_count\" IS '风险用户数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_merchant_diagnostics\".\"merchant_tag\" IS '商家标签字段';\n\n\n\n\n"}
