{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-20 14:17:10","sql":"CREATE TABLE \"${schemaName}\".\"b_repurchase_scores\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"user_id\" bigint   NOT NULL ,\n\"merchant_id\" bigint   NOT NULL ,\n\"repurchase_score\" decimal   NOT NULL ,\n\"risk_level\" varchar   NOT NULL ,\n\"priority_level\" varchar   NOT NULL ,\n\"score_rank_in_merchant\" int   NOT NULL ,\n\"top_reasons\" varchar   NOT NULL ,\n\"age_range\" varchar   NOT NULL ,\n\"gender\" varchar   NOT NULL ,\n\"days_since_last_action\" int   NOT NULL ,\n\"days_since_last_purchase\" int   NOT NULL ,\n\"cart_cnt_30d\" integer   NOT NULL ,\n\"favorite_cnt_30d\" decimal   NOT NULL ,\n\"purchase_cnt_30d\" decimal   NOT NULL ,\n\"purchase_cnt_all\" decimal   NOT NULL ,\n\"click_cnt_all\" decimal   NOT NULL ,\n\"user_purchase_cnt_all\" decimal   NOT NULL ,\n\"user_click_cnt_all\" decimal   NOT NULL ,\n\"merchant_purchase_user_ratio_all\" decimal   NOT NULL ,\nCONSTRAINT \"b_repurchase_scores_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"b_repurchase_scores\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"user_id\" IS '用户ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"merchant_id\" IS '商家ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"repurchase_score\" IS '复购分数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"risk_level\" IS '风险等级字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"priority_level\" IS '优先级字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"score_rank_in_merchant\" IS '商家内排名字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"top_reasons\" IS '主要原因字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"age_range\" IS '年龄段字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"gender\" IS '性别字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"days_since_last_action\" IS '最近行为距今天数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"days_since_last_purchase\" IS '最近购买距今天数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"cart_cnt_30d\" IS '最近30天加购次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"favorite_cnt_30d\" IS '近30天收藏次数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"purchase_cnt_30d\" IS '近30天购买次数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"purchase_cnt_all\" IS '历史购买次数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"click_cnt_all\" IS '历史点击次数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"user_purchase_cnt_all\" IS '用户历史购买次数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"user_click_cnt_all\" IS '用户历史点击次数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_repurchase_scores\".\"merchant_purchase_user_ratio_all\" IS '商家历史购买用户占比字段';\n\n\n\n\n"}
