{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-11 17:47:19","sql":"CREATE TABLE \"${schemaName}\".\"rec_tmall_item_similarity\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"source_item_id\" bigint   NOT NULL ,\n\"similar_item_id\" bigint   NOT NULL ,\n\"similarity_score\" numeric (10,6)  NOT NULL ,\n\"rank_no\" integer   NOT NULL ,\n\"category\" varchar (64)  NOT NULL ,\nCONSTRAINT \"rec_tmall_item_similarity_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"rec_tmall_item_similarity\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"source_item_id\" IS '复合主键，被比较的商品';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"similar_item_id\" IS '复合主键，相似的推荐商品';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"similarity_score\" IS '相似度得分，数值越大越相似';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"rank_no\" IS '相似度排名序号';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_similarity\".\"category\" IS '商品所属类目';\n\n\n\n\n"}
