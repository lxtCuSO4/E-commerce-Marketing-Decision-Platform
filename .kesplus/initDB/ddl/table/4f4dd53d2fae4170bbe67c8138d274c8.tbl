{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-20 14:39:05","sql":"CREATE TABLE \"${schemaName}\".\"b_recall_tasks\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"user_id\" bigint   NOT NULL ,\n\"merchant_id\" bigint   NOT NULL ,\n\"repurchase_score\" decimal   NOT NULL ,\n\"segment_name\" varchar   NOT NULL ,\n\"recommended_action\" varchar   NOT NULL ,\n\"priority_level\" varchar   NOT NULL ,\n\"reason_tags\" varchar   NOT NULL ,\n\"task_group\" varchar   NOT NULL ,\nCONSTRAINT \"b_recall_tasks_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"b_recall_tasks\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"user_id\" IS '用户ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"merchant_id\" IS '商家ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"repurchase_score\" IS '复购分数字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"segment_name\" IS '用户分群名称字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"recommended_action\" IS '推荐动作字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"priority_level\" IS '优先级字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"reason_tags\" IS '原因标签字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_recall_tasks\".\"task_group\" IS '任务分组字段';\n\n\n\n\n"}
