{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-20 14:18:10","sql":"CREATE TABLE \"${schemaName}\".\"b_user_segments\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"user_id\" bigint   NOT NULL ,\n\"segment_id\" int   NOT NULL ,\n\"segment_name\" varchar   NOT NULL ,\nCONSTRAINT \"b_user_segments_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"b_user_segments\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"b_user_segments\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_user_segments\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_user_segments\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_user_segments\".\"user_id\" IS '用户ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_user_segments\".\"segment_id\" IS '分群ID字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"b_user_segments\".\"segment_name\" IS '分群名称字段';\n\n\n\n\n"}
