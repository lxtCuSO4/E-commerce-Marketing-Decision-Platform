{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-15 22:28:53","sql":"CREATE TABLE \"${schemaName}\".\"rec_sales_forecast_predictions\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"item_id\" bigint   NOT NULL ,\n\"anchor_date\" date   NOT NULL ,\n\"category\" varchar   NOT NULL ,\n\"brand_id\" varchar   NOT NULL ,\n\"seller_id\" varchar   NOT NULL ,\n\"pay_cnt_7d\" integer   NOT NULL ,\n\"pay_cnt_30d\" integer   NOT NULL ,\n\"pred_pay_d1\" decimal   NOT NULL ,\n\"pred_pay_d2\" decimal   NOT NULL ,\n\"pred_pay_d3\" decimal   NOT NULL ,\n\"pred_pay_d4\" decimal   NOT NULL ,\n\"pred_pay_d5\" decimal   NOT NULL ,\n\"pred_pay_d6\" decimal   NOT NULL ,\n\"pred_pay_d7\" decimal   NOT NULL ,\n\"pred_7d_pay\" decimal   NOT NULL ,\nCONSTRAINT \"rec_sales_forecast_predictions_id_pk\" PRIMARY KEY (id,anchor_date) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"rec_sales_forecast_predictions\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"item_id\" IS '商品唯一标识';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"anchor_date\" IS '特征计算的基准日期';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"category\" IS '商品所属类目';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"brand_id\" IS '品牌标识';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"seller_id\" IS '商家标识';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pay_cnt_7d\" IS '最近7天支付次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pay_cnt_30d\" IS '最近30天支付次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d1\" IS '预测第1天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d2\" IS '预测第2天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d3\" IS '预测第3天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d4\" IS '预测第4天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d5\" IS '预测第5天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d6\" IS '预测第6天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_pay_d7\" IS '预测第7天支付字段';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_sales_forecast_predictions\".\"pred_7d_pay\" IS '7天预测支付总额字段';\n\n\n\n\n"}
