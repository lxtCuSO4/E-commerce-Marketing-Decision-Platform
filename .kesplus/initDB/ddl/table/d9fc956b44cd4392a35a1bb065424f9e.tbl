{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-11 17:45:11","sql":"CREATE TABLE \"${schemaName}\".\"rec_tmall_item_sales\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"item_id\" bigint   NOT NULL ,\n\"click_cnt\" integer   NOT NULL ,\n\"collect_cnt\" integer   NOT NULL ,\n\"cart_cnt\" integer   NOT NULL ,\n\"pay_cnt\" integer   NOT NULL ,\n\"last_action_time\" timestamp without time zone   NULL ,\nCONSTRAINT \"rec_tmall_item_sales_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"rec_tmall_item_sales\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"item_id\" IS '商品唯一标识，主键';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"click_cnt\" IS '累计点击次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"collect_cnt\" IS '累计收藏次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"cart_cnt\" IS '累计加购次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"pay_cnt\" IS '累计支付次数';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_sales\".\"last_action_time\" IS '最近一次行为时间戳';\n\n\n\n\n"}
