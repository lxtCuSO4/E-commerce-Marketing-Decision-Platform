{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2026-03-11 17:41:01","sql":"CREATE TABLE \"${schemaName}\".\"rec_tmall_item_base\"(\n\"id\" varchar   NOT NULL ,\n\"module_code\" varchar   NOT NULL ,\n\"dept_id\" varchar   NOT NULL ,\n\"item_id\" bigint   NOT NULL ,\n\"title\" text   NULL ,\n\"title_clean\" text   NULL ,\n\"title_tokens\" text   NULL ,\n\"pict_url\" text   NULL ,\n\"category\" varchar   NULL ,\n\"brand_id\" varchar   NULL ,\n\"seller_id\" varchar   NULL ,\nCONSTRAINT \"rec_tmall_item_base_id_pk\" PRIMARY KEY (id) ENABLE VALIDATE \n)  ;\nALTER TABLE \"${schemaName}\".\"rec_tmall_item_base\" SET TABLESPACE sys_default;\n\n\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"id\" IS 'id';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"module_code\" IS '模块代码';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"dept_id\" IS '部门ID';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"item_id\" IS '商品唯一标识，主键';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"title\" IS '商品原始标题';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"title_clean\" IS '清洗后的商品标题';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"title_tokens\" IS '标题分词结果';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"pict_url\" IS '商品图片链接';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"category\" IS '商品所属类目';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"brand_id\" IS '品牌标识';\nCOMMENT ON COLUMN \"${schemaName}\".\"rec_tmall_item_base\".\"seller_id\" IS '商家标识';\n\n\n\n\n"}
