	/**
	* @Description 删除（支持批量删除） (已发布RESTful:/SalesPredictModule/rec_tmall_sales_forecast_feature/del)
	* @param ids 主键，多个id使用逗号分隔
	* @Return
	*/
	PROCEDURE del(ids varchar) AS
	DECLARE
		v_id varchar;
		v_data jsonb;
		v_error_data jsonb;
		v_execute_delete_sql text;
	BEGIN
		IF trim(ids) IS NULL THEN
			RAISE EXCEPTION '请选择删除数据!';
		END IF;
		

		--删除主表数据
		DELETE FROM SalesPredictModule.rec_tmall_sales_forecast_feature WHERE id IN (select regexp_split_to_table(ids,','));
		EXCEPTION
			WHEN OTHERS THEN
		 		v_error_data :=kesplus_platform.EXCEPTION.errdata(SQLSTATE);
				kesplus_platform.business_exception(v_error_data->>'code',v_error_data->>'msg');
	END del;

	/**
	* @Description 根据主键查询详情 (已发布RESTful:/SalesPredictModule/rec_tmall_sales_forecast_feature/detail)
	* @param id_ 主键
	* @Return json
	*/
	FUNCTION get_by_id(id varchar) RETURNS JSONB AS
	DECLARE
		v_result_json jsonb;
		v_execute_get_query_sql text;
	BEGIN
		IF trim(id) IS NULL THEN
			RAISE EXCEPTION 'id不能为空';
		END IF;

		--查询语句,其中查询条件和排序规则使用占位符
		v_execute_get_query_sql :='
            SELECT t1.* 
            /*查询主表数据*/
            from (
                SELECT 					ROWNUM AS "rn",
					t1.id as id,					t1.item_id as itemId,					t1.anchor_date as anchorDate,					t1.category as category,					t1.brand_id as brandId,					t1.seller_id as sellerId,					t1.click_cnt_1d as clickCnt1D,					t1.click_uv_1d as clickUv1D,					t1.click_avg_1d as clickAvg1D,					t1.click_is_zero_1d as clickIsZero1D,					t1.click_cnt_3d as clickCnt3D,					t1.click_uv_3d as clickUv3D,					t1.click_avg_3d as clickAvg3D,					t1.click_is_zero_3d as clickIsZero3D,					t1.click_cnt_7d as clickCnt7D,					t1.click_uv_7d as clickUv7D,					t1.click_avg_7d as clickAvg7D,					t1.click_is_zero_7d as clickIsZero7D,					t1.click_cnt_14d as clickCnt14D,					t1.click_uv_14d as clickUv14D,					t1.click_avg_14d as clickAvg14D,					t1.click_is_zero_14d as clickIsZero14D,					t1.click_cnt_30d as clickCnt30D,					t1.click_uv_30d as clickUv30D,					t1.click_avg_30d as clickAvg30D,					t1.click_is_zero_30d as clickIsZero30D,					t1.collect_cnt_1d as collectCnt1D,					t1.collect_uv_1d as collectUv1D,					t1.collect_avg_1d as collectAvg1D,					t1.collect_is_zero_1d as collectIsZero1D,					t1.collect_cnt_3d as collectCnt3D,					t1.collect_uv_3d as collectUv3D,					t1.collect_avg_3d as collectAvg3D,					t1.collect_is_zero_3d as collectIsZero3D,					t1.collect_cnt_7d as collectCnt7D,					t1.collect_uv_7d as collectUv7D,					t1.collect_avg_7d as collectAvg7D,					t1.collect_is_zero_7d as collectIsZero7D,					t1.collect_cnt_14d as collectCnt14D,					t1.collect_uv_14d as collectUv14D,					t1.collect_avg_14d as collectAvg14D,					t1.collect_is_zero_14d as collectIsZero14D,					t1.collect_cnt_30d as collectCnt30D,					t1.collect_uv_30d as collectUv30D,					t1.collect_avg_30d as collectAvg30D,					t1.collect_is_zero_30d as collectIsZero30D,					t1.cart_cnt_1d as cartCnt1D,					t1.cart_uv_1d as cartUv1D,					t1.cart_avg_1d as cartAvg1D,					t1.cart_is_zero_1d as cartIsZero1D,					t1.cart_cnt_3d as cartCnt3D,					t1.cart_uv_3d as cartUv3D,					t1.cart_avg_3d a