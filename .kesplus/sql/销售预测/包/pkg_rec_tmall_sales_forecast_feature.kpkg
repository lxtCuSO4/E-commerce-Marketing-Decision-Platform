s payMean30D,					t1.pay_std_7d as payStd7D,					t1.pay_std_14d as payStd14D,					t1.pay_std_30d as payStd30D,					t1.pay_max_7d as payMax7D,					t1.pay_max_14d as payMax14D,					t1.pay_max_30d as payMax30D,					t1.click_mean_7d as clickMean7D,					t1.click_mean_14d as clickMean14D,					t1.click_mean_30d as clickMean30D,					t1.click_std_7d as clickStd7D,					t1.click_std_14d as clickStd14D,					t1.click_std_30d as clickStd30D,					t1.pay_active_days_30d as payActiveDays30D,					t1.active_days_30d as activeDays30D,					t1.days_since_last_click as daysSinceLastClick,					t1.days_since_last_pay as daysSinceLastPay,					t1.cumulative_active_days as cumulativeActiveDays,					t1.cumulative_pay_days as cumulativePayDays,					t1.item_age_days as itemAgeDays,					t1.day_of_week as dayOfWeek,					t1.is_weekend as isWeekend,					t1.day_of_month as dayOfMonth,					t1.month as month 
				FROM SalesPredictModule.rec_tmall_sales_forecast_feature t1
				%s
            )
        ';

		--查询语句,其中查询条件和排序规则使用占位符
		v_execute_page_query_sql :='
            SELECT t1.* 
            /*查询主表数据*/
            from (
                SELECT 					ROWNUM AS "rn",
					t1.id as id,					t1.item_id as itemId,					t1.anchor_date as anchorDate,					t1.category as category,					t1.brand_id as brandId,					t1.seller_id as sellerId,					t1.click_cnt_1d as clickCnt1D,					t1.click_uv_1d as clickUv1D,					t1.click_avg_1d as clickAvg1D,					t1.click_is_zero_1d as clickIsZero1D,					t1.click_cnt_3d as clickCnt3D,					t1.click_uv_3d as clickUv3D,					t1.click_avg_3d as clickAvg3D,					t1.click_is_zero_3d as clickIsZero3D,					t1.click_cnt_7d as clickCnt7D,					t1.click_uv_7d as clickUv7D,					t1.click_avg_7d as clickAvg7D,					t1.click_is_zero_7d as clickIsZero7D,					t1.click_cnt_14d as clickCnt14D,					t1.click_uv_14d as clickUv14D,					t1.click_avg_14d as clickAvg14D,					t1.click_is_zero_14d as clickIsZero14D,					t1.click_cnt_30d as clickCnt30D,					t1.click_uv_30d as clickUv30D,					t1.click_avg_30d as clickAvg30D,					t1.click_is_zero_30d as clickIsZero30D,					t1.collect_cnt_1d as collectCnt1D,					t1.collect_uv_1d as collectUv1D,					t1.collect_avg_1d as collectAvg1D,					t1.collect_is_zero_1d as collectIsZero1D,					t1.collect_cnt_3d as collectCnt3D,					t1.collect_uv_3d as collectUv3D,					t1.collect_avg_3d as collectAvg3D,					t1.collect_is_zero_3d as collectIsZero3D,					t1.collect_cnt_7d as collectCnt7D,					t1.collect_uv_7d as collectUv7D,					t1.collect_avg_7d as collectAvg7D,					t1.collect_is_zero_7d as collectIsZero7D,					t1.collect_cnt_14d as collectCnt14D,					t1.collect_uv_14d as collectUv14D,					t1.collect_avg_14d as collectAvg14D,					t1.collect_is_zero_14d as collectIsZero14D,					t1.collect_cnt_30d as collectCnt30D,					t1.collect_uv_30d as collectUv30D,					t1.collect_avg_30d as collectAvg30D,					t1.collect_is_zero_30d as collectIsZero30D,					t1.cart_cnt_1d as cartCnt1D,					t1.cart_uv_1d as cartUv1D,					t1.cart_avg_1d as cartAvg1D,					t1.cart_is_zero_1d as cartIsZero1D,					t1.cart_cnt_3d as cartCnt3D,					t1.cart_uv_3d as cartUv3D,					t1.cart_avg_3d as cartAvg3D,					t1.cart_is_zero_3d as cartIsZero3D,					t1.cart_cnt_7d as cartCnt7D,					t1.cart_uv_7d as cartUv7D,					t1.cart_avg_7d as cartAvg7D,					t1.cart_is_zero_7d as cartIsZero7D,					t1.cart_cnt_14d as cartCnt14D,					t1.cart_uv_14d as cartUv14D,					t1.cart_avg_14d as cartAvg14D,					t1.cart_is_zero_14d as cartIsZero14D,					t1.cart_cnt_30d as cartCnt30D,					t1.cart_uv_30d as cartUv30D,					t1.cart_avg_30d as cartAvg30D,					t1.cart_is_zero_30d as cartIsZero30D,					t1.pay_cnt_1d as payCnt1D,					t1.pay_uv_1d as payUv1D,					t1.pay_avg_1d as payAvg1D,					t1.pay_is_zero_1d as payIsZero1D,					t1.pay_cnt_3d as payCnt3D,					t1.pay_uv_3d as payUv3D,					t1.pay_avg_3d as payAvg3D,					t1.pay_is_zero_3d as payIsZero3D,					t1.pay_cnt_7d as payCnt7D,					t1.pay_uv_7d as payUv7D,					t1.pay_avg_7d as payAvg7D,					t1.pay_is_zero_7d as payIsZero7D,					t1.pay_cnt_14d as payCnt14D,					t1.pay_uv_14d as payUv14D,					t1.pay_avg_14d as payAvg14D,					t1.pay_is_zero_14d as payIsZero14D,					t1.pay_cnt_30d as payCnt30D,					t1.pay_uv_30d as payUv30D,					t1.pay_avg_30d as payAvg30D,					t1.pay_is_zero_30d as payIsZero30D,					t1.click_cnt_prev_7d as clickCntPrev7D,					t1.pay_cnt_prev_7d as payCntPrev7D,					t1.cart_cnt_prev_7d as cartCntPrev7D,					t1.click_cnt_prev_14d as clickCntPrev14D,					t1.pay_cnt_prev_14d as payCntPrev14D,					t1.pay_per_click_7d as payPerClick7D,					t1.cart_per_click_7d as cartPerClick7D,					t1.collect_per_click_7d as collectPerClick7D,					t1.pay_uv_per_click_uv_7d as payUvPerClickUv7D,					t1.pay_ratio_3d_to_7d as payRatio3DTo7D,					t1.pay_ratio_7d_to_14d as payRatio7DTo14D,					t1.click_cnt_delta_7d as clickCntDelta7D,					t1.pay_cnt_delta_7d as payCntDelta7D,					t1.cart_cnt_delta_7d as cartCntDelta7D,					t1.pay_cnt_delta_14d as payCntDelta14D,					t1.click_cnt_delta_14d as clickCntDelta14D,					t1.pay_mean_7d as payMean7D,					t1.pay_mean_14d as payMean14D,					t1.pay_mean_30d as payMean30D,					t1.pay_std_7d as payStd7D,					t1.pay_std_14d as payStd14D,					t1.pay_std_30d as payStd30D,					t1.pay_max_7d as payMax7D,					t1.pay_max_14d as payMax14D,					t1.pay_max_30d as payMax30D,					t1.click_mean_7d as clickMean7D,					t1.click_mean_14d as clickMean14D,					t1.click_mean_30d as clickMean30D,					t1.click_std_7d as clickStd7D,					t1.click_std_14d as clickStd14D,					t1.click_std_30d as clickStd30D,					t1.pay_active_days_30d as payActiveDays30D,					t1.active_days_30d as activeDays30D,					t1.days_since_last_click as daysSinceLastClick,					t1.days_since_last_pay as daysSinceLastPay,					t1.cumulative_active_days as cumulativeActiveDays,					t1.cumulative_pay_days as cumulativePayDays,					t1.item_age_days as itemAgeDays,					t1.day_of_week as dayOfWeek,					t1.is_weekend as isWeekend,					t1.day_of_month as dayOfMonth,					t1.month as month 
				FROM SalesPredictModule.rec_tmall_sales_forecast_feature t1
				%s
            ) as t1 
            %s
        ';

		--进行分页查询
		SELECT kesplus_platform.page.page(jsonb_build_object('countSql',format(v_execute_count_query_sql,v_condition_sql),'querySql',format(v_execute_page_query_sql,v_condition_sql,nvl(v_orderby_sql,' ')  || ' limit $1 offset $2')),(jsonData ->> 'pageIndex'),(jsonData ->> 'pageSize')) INTO v_result_json;

		RETURN v_result_json;
		EXCEPTION
			WHEN OTHERS THEN
		 		v_error_data :=kesplus_platform.EXCEPTION.errdata(SQLSTATE);
				kesplus_platform.business_exception(v_error_data->>'code',v_error_data->>'msg');
	END page;



	/**
	* @Description 工作流表单回调存储过程实现
	* @param flowContent 流程上下文信息
	*/
	PROCEDURE workflowCallback(flowContent JSONB) AS
	DECLARE
		v_business_id varchar;
		v_process_instance_id varchar;
		v_process_status varchar;
	BEGIN
		/*表单id*/
		v_business_id := flowContent ->>'business_id';
		/*流程实例id*/
		v_process_instance_id := flowContent ->>'process_instance_id';
		v_process_status := flowContent ->>'process_status';

		/*流程启动后*/
		IF v_process_status = 'start' THEN
			/*表单更新操作*/
			/*示例如下，请根据实际业务需求进行调整*/
			/*
			update "rec_tmall_sales_forecast_feature" set status=2,process_id=v_process_instance_id where id= v_business_id;
			*/
		END IF;

		/*流程完成后*/
		IF v_process_status = 'end' THEN
			/*表单更新操作*/
			/*示例如下，请根据实际业务需求进行调整*/
			/*
			update "rec_tmall_sales_forecast_feature" set status=4 where id= v_business_id;
			*/
		END IF;

		/*流程撤回后*/
		IF v_process_status = 'cancel' THEN
			/*表单更新操作*/
			/*示例如下，请根据实际业务需求进行调整*/
			/*
			update "rec_tmall_sales_forecast_feature" set status=5,process_id=null where id= v_business_id;
			*/
		END IF;

	END workflowCallback;


	
END;