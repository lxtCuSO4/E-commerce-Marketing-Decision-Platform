	/**
	* @Description 保存主子表表单数据 (已发布RESTful:/SalesPredictModule/rec_tmall_sales_forecast_feature/add)
	* @param jsonData JSONB 结构化的表单数据对象,格式为：{"param1": "value1","param2": "value2"} 如想要取某个值，可以使用jsonData->>'param1'
	* @Return JSONB 返回包含主表id的结构化数据
	*/
	FUNCTION add(jsonData jsonb) RETURN JSONB AS
	DECLARE
