create or replace function "SalesPredictModule"."getSalesForecastPredictionsByParams"(item_id integer,anchor_date date) return JSON as
/**
 * @Description 根据商品ID和锚定日期查询销量预测结果
 * @Param item_id 商品ID，精确匹配，非必填
 * @Param anchor_date 锚定日期，精确匹配，非必填
 * @Return JSON
 */
declare
  v_result json;
  v_where_sql text := ' where 1=1 ';
  execute_sql text;
begin
  if item_id is not null then
    v_where_sql := v_where_sql || format(' and t1.item_id = %s', item_id);
  end if;

  if anchor_date is not null then
    v_where_sql := v_where_sql || format(' and t1.anchor_date = %L::date', anchor_date);
  end if;

  execute_sql := '
    select
      t1.id as "id",
      t1.item_id as "itemId",
      t1.anchor_date as "anchorDate",
      t1.category as "category",
      t1.brand_id as "brandId",
      t1.seller_id as "sellerId",
      t1.pay_cnt_7d as "payCnt7D",
      t1.pay_cnt_30d as "payCnt30D",
      t1.pred_pay_d1 as "predPayD1",
      t1.pred_pay_d2 as "predPayD2",
      t1.pred_pay_d3 as "predPayD3",
      t1.pred_pay_d4 as "predPayD4",
      t1.pred_pay_d5 as "predPayD5",
      t1.pred_pay_d6 as "predPayD6",
      t1.pred_pay_d7 as "predPayD7",
      t1.pred_7d_pay as "pred7DPay"
    from "SalesPredictModule".rec_sales_forecast_predictions t1
    ' || v_where_sql || '
    order by t1.item_id, t1.anchor_date
  ';

  execute kesplus_platform.json.array_sql(execute_sql)
    into v_result;

  return v_result;
end;
