CREATE OR REPLACE FUNCTION "SalesPredictModule"."predictSalesForecastOnline"(item_id integer,anchor_date date,horizon_days integer,feature_data json) RETURN JSON AS
/**
 * @Description 通过 Kesplus 应用侧同源接口转发销量预测请求到官方模型托管 FastAPI
 * @Param item_id 商品ID，必填
 * @Param anchor_date 锚定日期，必填
 * @Param horizon_days 预测天数，非必填，默认 7
 * @Param feature_data 特征数据，JSON 对象，必填
 * @Return JSON
 */
declare
  l_request_url varchar := 'http://fastapi:54903/api/EMDMP/sales-forecast/predict';
  l_payload json;
  l_response jsonb;
  l_response_content jsonb;
  l_response_data jsonb;
begin
  if item_id is null then
    return json_build_object(
      'success', false,
      'message', 'item_id 不能为空',
      'errorCode', 'invalid_item_id'
    );
  end if;

  if anchor_date is null then
    return json_build_object(
      'success', false,
      'message', 'anchor_date 不能为空',
      'errorCode', 'invalid_anchor_date'
    );
  end if;

  if feature_data is null then
    return json_build_object(
      'success', false,
      'message', 'feature_data 不能为空',
      'errorCode', 'invalid_feature_data'
    );
  end if;

  l_payload := json_build_object(
    'itemId', item_id,
    'anchorDate', anchor_date,
    'horizonDays', coalesce(horizon_days, 7),
    'featureData', feature_data
  );

  set http.timeout_msec = 30000;

  select "kesplus_platform"."http".POST(
    l_request_url,
    l_payload
  ) into l_response;

  l_response_content := coalesce(
    l_response -> 'content',
    '{}'::jsonb
  );

  l_response_data := coalesce(
    l_response #> '{content,data}',
    l_response -> 'data',
    l_response_content,
    l_response
  );

  /*
   * 官方模型服务成功时，success 位于 content 层；
   * 真正预测结果位于 content.data 层
   */
  if jsonb_typeof(l_response_content) = 'object'
     and coalesce(l_response_content->>'success', '') = 'true' then
    return json_build_object(
      'success', true,
      'message', '在线预测成功',
      'requestUrl', l_request_url,
      'requestPayload', l_payload,
      'rawResponse', l_response,
      'data', l_response_data
    );
  end if;

  /*
   * 兼容某些返回结构直接把 success 放在 data 层
   */
  if jsonb_typeof(l_response_data) = 'object'
     and coalesce(l_response_data->>'success', '') = 'true' then
    return json_build_object(
      'success', true,
      'message', '在线预测成功',
      'requestUrl', l_request_url,
      'requestPayload', l_payload,
      'rawResponse', l_response,
      'data', l_response_data
    );
  end if;

  return json_build_object(
    'success', false,
    'message', '在线预测失败，模型服务返回异常结果',
    'errorCode', 'invalid_response',
    'requestUrl', l_request_url,
    'requestPayload', l_payload,
    'rawResponse', l_response,
    'data', l_response_data
  );

exception
  when others then
    return json_build_object(
      'success', false,
      'message', '调用销量预测模型失败：' || SQLERRM,
      'errorCode', 'forward_failed',
      'requestUrl', l_request_url,
      'requestPayload', l_payload
    );
end;
