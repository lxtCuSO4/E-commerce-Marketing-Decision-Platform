CREATE OR REPLACE FUNCTION "AiModule"."getGenerateUserBehaviorDiagnosisTaskProxy"(task_id varchar) RETURN JSON AS
/**
 * @Description 查询用户行为诊断任务状态（伪异步兼容）
 * @Param task_id 任务ID
 * @Return JSON
 */
begin
  return json_build_object(
    'success', true,
    'message', '用户行为诊断任务已完成',
    'enhancementTaskId', task_id,
    'enhancementStatus', 'completed',
    'data', json_build_object(
      'content', '请在 startGenerateUserBehaviorDiagnosisProxy 返回结果中读取诊断内容，当前为伪异步兼容模式。'
    )
  );
end;
