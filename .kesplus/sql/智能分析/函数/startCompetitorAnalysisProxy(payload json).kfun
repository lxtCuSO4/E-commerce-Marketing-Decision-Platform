CREATE OR REPLACE FUNCTION "AiModule"."startCompetitorAnalysisProxy"(payload json) RETURN JSON AS
/**
 * @Description 启动竞品分析任务（伪异步）
 * @Param payload JSON
 * @Return JSON
 */
declare
  l_task_id varchar := replace(gen_random_uuid()::varchar, '-', '');
  l_result jsonb;
begin
  l_result := "AiModule"."generateCompetitorAnalysisProxy"(payload)::jsonb;

  return json_build_object(
    'success', coalesce((l_result ->> 'success')::boolean, false),
    'message', coalesce(l_result ->> 'message', '竞品分析任务已启动'),
    'enhancementTaskId', l_task_id,
    'enhancementStatus', 'completed',
    'requestUrl', l_result ->> 'requestUrl',
    'requestPayload', l_result -> 'requestPayload',
    'rawResponse', l_result,
    'data', l_result -> 'data'
  );
end;
