CREATE OR REPLACE FUNCTION "AiModule"."getCompetitorAnalysisTaskProxy"(task_id varchar) RETURN JSON AS
/**
 * @Description 查询竞品分析任务状态（伪异步兼容）
 * @Param task_id 任务ID
 * @Return JSON
 */
begin
  return json_build_object(
    'success', true,
    'message', '竞品分析任务已完成',
    'enhancementTaskId', task_id,
    'enhancementStatus', 'completed',
    'data', json_build_object(
      'content', '请在 startCompetitorAnalysisProxy 返回结果中读取分析内容，当前为伪异步兼容模式。'
    )
  );
end;
