create or replace function "DataImportModule"."getItemSalesByItemId"(item_id integer) return JSON as
/**
 * @Description 根据商品ID查询商品销售信息
 * @Param item_id 商品ID，精确匹配
 * @Return JSON
 */
declare
  v_result json;
  v_where_sql text := ' where 1=1 ';
  execute_sql text;
begin
  if item_id is not null then
    v_where_sql := v_where_sql || format(' and t1.item_id = %s', item_id);
  end if;

  execute_sql := '
    select
      t1.id as id,
      t1.item_id as itemId,
      t1.click_cnt as clickCnt,
      t1.collect_cnt as collectCnt,
      t1.cart_cnt as cartCnt,
      t1.pay_cnt as payCnt,
      t1.last_action_time as lastActionTime
    from "DataImportModule".rec_tmall_item_sales t1
    ' || v_where_sql || '
    order by t1.item_id
  ';

  execute kesplus_platform.json.array_sql(execute_sql)
    into v_result;

  return v_result;
end;
